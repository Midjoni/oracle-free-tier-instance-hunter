# Copy to config.env and edit. Everything here is optional — anything left unset is
# discovered automatically from your OCI config at runtime.

# --- which account -----------------------------------------------------------
# Profile name in ~/.oci/config. Run `oci setup config` first if you have none.
OCI_PROFILE=DEFAULT

# Path to the OCI config file (also honours the CLI's own OCI_CLI_CONFIG_FILE).
# OCI_CONFIG_FILE=$HOME/.oci/config

# Path to the oci binary. Useful if you installed it in a venv:
#   OCI_BIN=/home/ubuntu/oci-venv/bin/oci
# OCI_BIN=oci

# --- what to create ----------------------------------------------------------
# The free ARM shape. For the x86 micro shape use VM.Standard.E2.1.Micro, which
# ignores OCPUS/MEMORY_GB (it is a fixed 1/8 OCPU + 1 GB) and is far easier to get.
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12

BOOT_VOLUME_GB=50
DISPLAY_NAME=free-instance
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION=24.04
ASSIGN_PUBLIC_IP=true

# Public key installed on the new instance. You will log in as `ubuntu`.
# Unset = the first of ~/.ssh/id_ed25519.pub, id_rsa.pub, id_ecdsa.pub that exists.
# SSH_KEY_FILE=$HOME/.ssh/id_ed25519.pub

# --- pacing ------------------------------------------------------------------
# Seconds between attempts. Measured: 60s yields 20% FEWER real attempts than 120s,
# because Oracle throttles over a third of the calls. See the README FAQ.
INTERVAL=120
# Ceiling for the exponential backoff applied after a TooManyRequests response.
MAX_BACKOFF=900
# Stop after this many days. 0 = run forever.
DEADLINE_DAYS=0

# --- optional: told when it lands --------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=987654321
# WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- optional: skip discovery ------------------------------------------------
# Set these only if the automatic discovery picks the wrong thing.
# COMPARTMENT_ID=ocid1.compartment.oc1..xxxxx
# AVAILABILITY_DOMAINS=xxxx:US-ASHBURN-AD-1,xxxx:US-ASHBURN-AD-2
# SUBNET_ID=ocid1.subnet.oc1.....
# IMAGE_ID=ocid1.image.oc1.....
